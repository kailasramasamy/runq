# =============================================================================
# runQ Production Environment Variables
# Copy to .env and fill in all values before deploying
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://runq_app:STRONG_PASSWORD@db-host:5432/runq_prod
DB_POOL_MAX=20

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Authentication (MUST change from defaults) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_EXPIRES_IN=24h
# Mobile phone-OTP sessions (runq app). Longer: no refresh token, re-auth costs an SMS.
MOBILE_JWT_EXPIRES_IN=30d
SERVICE_JWT_SECRET=CHANGE_ME_64_CHAR_HEX
SERVICE_JWT_EXPIRES_IN=5m

# --- Portal Secrets (optional — falls back to JWT_SECRET) ---
PORTAL_JWT_SECRET=CHANGE_ME_64_CHAR_HEX
CA_PORTAL_SECRET=CHANGE_ME_64_CHAR_HEX

# --- Server ---
PORT=3003
NODE_ENV=production

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGIN=https://erp.yourcompany.com

# --- Webhook Security ---
WEBHOOK_SHARED_SECRET=CHANGE_ME_32_CHAR_RANDOM

# --- Email (SMTP) ---
MAIL_FROM=noreply@yourcompany.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourcompany.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=runQ Finance
EMAIL_DEBUG=false

# --- AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# --- File Storage (AWS S3) ---
# Files organized by tenant: {tenantId}/{entityType}/{entityId}/{timestamp}-{filename}
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
S3_BUCKET=runq-documents
# For S3-compatible providers (DO Spaces, MinIO), uncomment:
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com

# --- Optional: GSTIN Lookup ---
# GSTIN_API_KEY=your_gstin_api_key

# --- Optional: WhatsApp (Gupshup) ---
# WHATSAPP_PROVIDER=gupshup
# GUPSHUP_API_KEY=your_key
# GUPSHUP_APP_NAME=your_app
# GUPSHUP_SOURCE_NUMBER=your_number

# --- Dhenu farmer WhatsApp (Interakt) ---
# Unset INTERAKT_API_KEY = disabled (no pour-receipt messages sent).
# INTERAKT_API_KEY=your_interakt_api_key
# INTERAKT_API_URL=https://api.interakt.ai/v1
# INTERAKT_TEMPLATE_MILK_COLLECTION_RECEIPT=milk_collection_receipt

# --- Dhenu login OTP (MSG91) ---
# Unset MSG91_AUTH_KEY = SMS disabled (dev logs the code instead of sending).
# MSG91_AUTH_KEY=your_authkey
# MSG91_SENDER_ID=DHENUX
# MSG91_ROUTE=4
# MSG91_OTP_TEMPLATE_ID=your_template_id
# App/Play Store review bypass: a fixed code for demo numbers (no SMS sent).
# MP_DEMO_OTP=123456
# MP_DEMO_PHONES=9000000001

# --- Optional: Bank Feeds ---
# BANK_FEED_PROVIDER=mock
