{$SITE_ADDRESS:localhost:8080}

# Login page (shared, served from web app)
handle /login {
	root * /srv/web
	rewrite * /index.html
	file_server
}

# Finance app (SPA)
handle /finance/* {
	uri strip_prefix /finance
	root * /srv/web
	try_files {path} /index.html
	file_server
}

# Exact /finance redirect to /finance/
handle /finance {
	redir /finance/ permanent
}

# API proxy
handle /api/* {
	reverse_proxy {$API_URL:localhost:3003}
}

# Marketing site (SPA) — catch all
handle {
	root * /srv/www
	try_files {path} /index.html
	file_server
}

# Security headers
header {
	X-Frame-Options DENY
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

# Gzip/Brotli compression
encode gzip zstd
