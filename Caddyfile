{$SITE_ADDRESS:localhost:8080}

# Web SPA bundles (hashed JS/CSS emitted by Vite to dist/assets/). Vite uses
# absolute base="/", so the HTML at /login and /finance/* references
# /assets/index-XXX.js from the document root — not /finance/assets/...
# Without this rule, those requests fall through to the marketing catch-all
# and 200-return the marketing index.html, which the browser then tries to
# parse as a JS module → blank page.
handle /assets/* {
	root * /srv/web
	file_server
}

# Login page (shared, served from web app)
handle /login {
	root * /srv/web
	rewrite * /index.html
	file_server
}

# Finance app (SPA)
handle /finance/* {
	uri strip_prefix /finance
	root * /srv/web
	try_files {path} /index.html
	file_server
}

# Exact /finance redirect to /finance/
handle /finance {
	redir /finance/ permanent
}

# API proxy
handle /api/* {
	reverse_proxy {$API_URL:localhost:3003}
}

# Marketing site (SPA) — catch all
handle {
	root * /srv/www
	try_files {path} /index.html
	file_server
}

# Security headers
header {
	X-Frame-Options DENY
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

# Gzip/Brotli compression
encode gzip zstd
