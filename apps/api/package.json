{
  "name": "@runq/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --noEmit --watch --preserveWatchOutput\" \"tsx watch --env-file=../../.env src/index.ts\"",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "start": "tsx src/index.ts",
    "start:prod": "cd ../.. && pnpm --filter @runq/db db:setup && cd apps/api && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.1025.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@runq/db": "workspace:*",
    "@runq/types": "workspace:*",
    "@runq/validators": "workspace:*",
    "argon2": "^0.41.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^8.0.3",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.11.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
