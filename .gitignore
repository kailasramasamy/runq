# Flutter build output
apps/mobile/android/build/

# Ad-hoc milk-procurement dev/e2e scripts (kept local, not versioned)
apps/api/mp_*.mjs
packages/db/mp_*.mjs

# One-off scripts written against a dev database to answer a single question —
# probes, data fixes, spot checks. Dozens accumulate, and left untracked they
# bury the real changes in `git status` and get swept up by a careless
# `git add apps/api`.
#
# Matched by intent-naming rather than by extension, so a genuine file landing
# at the api root still shows up. Anchored to that root on purpose: everything
# versioned lives in apps/api/src/ or apps/api/scripts/, and a script named
# verify-* or seed-* in there is real work — neither directory is matched.
apps/api/probe-*.ts
apps/api/fix-*.ts
apps/api/verify-*.ts
apps/api/*.tmp.ts
apps/collect/test/_*probe*
