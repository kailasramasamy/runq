node_modules/
dist/
.next/
.turbo/
.env
.env.local
.env.*.local
*.log
.DS_Store
coverage/

# Runtime upload directory — per-tenant blobs land here, never commit.
apps/api/uploads/

# Editor / tool-local state
.claude/scheduled_tasks.lock
.claude/settings.local.json
docs/.obsidian/workspace.json
docs/.obsidian/graph.json
*.tsbuildinfo

# Flutter build output
apps/mobile/android/build/

# Ad-hoc milk-procurement dev/e2e scripts (kept local, not versioned)
apps/api/mp_*.mjs
packages/db/mp_*.mjs

# One-off scripts written against a dev database to answer a single question —
# probes, data fixes, spot checks. Dozens accumulate, and left untracked they
# bury the real changes in `git status` and get swept up by a careless
# `git add apps/api`.
#
# Anchored to the api root on purpose: everything versioned lives in
# apps/api/src/ or apps/api/scripts/, and neither is matched by this.
apps/api/*.ts
apps/collect/test/_*probe*.dart
