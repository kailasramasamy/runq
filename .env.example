# Database
DATABASE_URL=postgresql://runq_app:password@localhost:5432/runq_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
# Mobile phone-OTP sessions (runq app). Longer: no refresh token, re-auth costs an SMS.
MOBILE_JWT_EXPIRES_IN=30d
SERVICE_JWT_SECRET=change-me-service-secret
SERVICE_JWT_EXPIRES_IN=5m

# File Storage (DO Spaces / S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# App
PORT=3003
NODE_ENV=development
CORS_ORIGIN=http://localhost:4003
